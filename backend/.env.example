# Stock Radar 环境变量示例：复制为 backend/.env 使用
# LLM (DeepSeek 官方 API; 任意 OpenAI 兼容服务亦可)
SR_LLM_BASE_URL=https://api.deepseek.com
SR_LLM_API_KEY=
SR_LLM_MODEL=deepseek-v4-flash

# 行情数据源: auto(按健康状态与功能选取适用来源) | akshare | sina | tencent
SR_DATA_PROVIDER=auto
# 全市场扫描子集（按成交额取前 N，默认 500）
SR_MARKET_SCAN_LIMIT=500

# GP 计算后端: auto(mlx优先) | mlx | numpy
SR_GP_BACKEND=auto

# 可选：设置后 /api/v1（除 health/openapi.json）需携带 X-API-Token 请求头
# SR_API_TOKEN=replace-with-a-random-token
# 服务默认只监听本机；如需通过局域网访问，请显式配置绑定地址和鉴权。
# SR_HOST=0.0.0.0
# SR_FRONTEND_HOST=0.0.0.0
# 原生内核：SR_NATIVE=0 强制回退 numpy；SR_NATIVE_LIB 自定义库路径
# SR_NATIVE=0
# SR_NATIVE_LIB=/path/to/librolling.dylib

# CPU-only environments can disable MLX probing explicitly.
# SR_MLX_OFF=1
